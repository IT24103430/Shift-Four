+        {
+            var p=New();Tick(p,0);Tick(p,1,false,Vector3.one*9999,sound:Sound(.5f,8));Assert.That(Get(p,"UsingSound"),Is.False);
+            Assert.That(Get(p,"LastVisualAt"),Is.EqualTo(0));Assert.That(Get(p,"LastVisual"),Is.EqualTo(Target));
