+            Tick(p,7.1f);Assert.That(Side(p),Is.EqualTo(-1));Assert.That((int)Get(p,"FailureCount"),Is.LessThanOrEqualTo(8));
+        }
+        [Test] public void ReachedButObstructedFlank_IsRetiredForOtherSide()
